{
  "extends": ["config:best-practices", ":disableDependencyDashboard"],
  "enabledManagers": ["custom.regex","dockerfile", "ruby-version"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG RUBY_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby",
      "versioningTemplate": "ruby"
    }
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/Containerfile/"
    ]
  },
  "schedule": ["after 8am on tuesday"]
}
